index 0000000..673b2b5
--- /dev/null
+++ b/tools/vehicle_pipeline/blender/boilerfang_body.py
@@ -0,0 +1,184 @@
+"""Main body masses: hull, boiler barrel, fenders, plows, tanks and cylinders.
+
+Every mass is a closed, mirrored-by-construction solid (loft, sweep or lathe). They overlap like
+the cast and riveted parts of a real engine; the combined silhouette is checked against the
+traced side/top tables by validate_boilerfang.py.
+"""
+import math
+
+from mathutils import Matrix, Vector
+
+import boilerfang_forms as F
+import boilerfang_prims as P
+import boilerfang_trace as T
+
+HULL_MATS = ["paint", "paint2", "accent", "iron"]
+HULL_PX = [296, 304, 320, 340, 360, 380, 400, 420, 431.5, 433, 440, 446, 452, 460, 470, 490, 510,
+           530, 550, 565, 580, 595, 610, 625, 640, 655, 670, 685, 695, 702, 710, 718, 726, 740,
+           760, 780, 800, 820, 840, 852, 862]
+CROWN = [(296, 0.03), (431, 0.03), (433, 0.0), (460, 0.0), (470, 0.05), (560, 0.05), (600, 0.03),
+         (640, 0.02), (695, 0.02), (702, 0.0), (725, 0.0), (735, 0.03), (862, 0.03)]
+ARCH_STEPS = {"truck": 22, "coupe": 18}
+BARREL_Z = (0.60, 1.06)
+DECK_Z = 0.62
+CAB_PX = 432.2
+
+
+def hull_top(px):
+    """Flat-part top of the hull; the crown lifts the centreline to the traced silhouette."""
+    return DECK_Z if px < CAB_PX else T.top_z(px) - T.lerp_table(CROWN, px)
+
+
+def hull_ring(px):
+    w = T.half_w(px)
+    zb, zt = T.sill_z(px), hull_top(px)
+    crown = T.lerp_table(CROWN, px)
+    split = zb + 0.16 if px < 432 else 0.50
+    half, roles = F.section_half(w, zb, zt, 0.05, 0.09 if CAB_PX < px < 640 else 0.06, crown,
+                                 split=split)
+    return F.full_ring(half, roles)
+
+
+def build_hull(builder):
+    stations, roles = [], None
+    for px in HULL_PX:
+        ring, roles = hull_ring(px)
+        stations.append((T.X(px), ring))
+    return F.loft(builder, "Body_Hull", stations, HULL_MATS, row_mats=roles)
+
+
+def barrel_ring(px, grow=0.0):
+    w = T.half_w(px) + grow
+    half, roles = F.section_half(w, BARREL_Z[0] - grow, BARREL_Z[1] + grow, 0.19, 0.19, 0.0,
+                                 steps=5, crown_steps=2)
+    return F.full_ring(half, roles)
+
+
+def build_barrel(builder):
+    """Copper boiler barrel on the truck deck with riveted brass bands."""
+    stations = []
+    for px in (296, 310, 340, 370, 400, 431.9):
+        ring, roles = barrel_ring(px)
+        stations.append((T.X(px), ring))
+    n = len(stations[0][1])
+    barrel = F.loft(builder, "Body_BoilerBarrel", stations, ["copper"], row_mats=[0] * n)
+    bands = []
+    for k, px in enumerate((318, 352, 388, 418)):
+        a, b = T.X(px - 3), T.X(px + 3)
+        ra, _ = barrel_ring(px - 3, 0.007)
+        rb_, _ = barrel_ring(px + 3, 0.007)
+        bands.append(F.loft(builder, f"Trim_BoilerBand_{k}", [(a, ra), (b, rb_)], ["brass"],
+                            row_mats=[0] * len(ra), smooth_angle=60))
+    return barrel, bands
+
+
+def arch_path(hub, radius, a0, a1, steps):
+    pts = []
+    for k in range(steps + 1):
+        a = math.radians(a0 + (a1 - a0) * k / steps)
+        pts.append((hub[0] + radius * math.cos(a), hub[1] + radius * math.sin(a)))
+    return pts
+
+
+def build_fenders(builder):
+    """Mudguards over the wheels: truck arches over the knobby tyres, speedster pontoons."""
+    out = []
+    for side in (-1, 1):
+        sgn = "+" if side > 0 else "-"
+        hub = (T.WHEEL_X["truck"], T.WHEEL_R["truck"])
+        r = hub[1] + 0.045 + 0.0075
+        path = arch_path(hub, r, 215, -35, ARCH_STEPS["truck"])
+        o = F.sweep_band(builder, f"Body_FenderTruck_{sgn}", path, 0.32 if side > 0 else -0.62,
+                         0.62 if side > 0 else -0.32, 0.022, "paint")
+        out.append(o)
+        for k, yy in enumerate((0.32, 0.62)):
+            out.append(P.sweep(builder, f"Trim_FenderBeadTruck_{sgn}_{k}", [(x, side * yy, z) for x, z in path],
+                               "brass", radius=0.0085, sides=6))
+        # speedster pontoon: running board, rise over the arch, nose drop
+        hub = (T.WHEEL_X["coupe"], T.WHEEL_R["coupe"])
+        r = hub[1] + 0.045 + 0.0075
+        arc = arch_path(hub, r, 152, -28, ARCH_STEPS["coupe"])
+        rear = [(T.X(696), 0.115), (1.12, 0.115), (1.30, 0.22)]
+        path = rear + arc
+        o = F.sweep_band(builder, f"Body_FenderSpeedster_{sgn}", path, 0.36 if side > 0 else -0.64,
+                         0.64 if side > 0 else -0.36, 0.022, "paint")
+        out.append(o)
+        for k, yy in enumerate((0.36, 0.64)):
+            out.append(P.sweep(builder, f"Trim_FenderBeadSpeedster_{sgn}_{k}", [(x, side * yy, z) for x, z in path],
+                               "brass", radius=0.0085, sides=6))
+    return out
+
+
+def wedge(builder, name, plan, z_bottom, z_top_fn, mat, bevel=0.006):
+    """Closed prism over a plan polygon (x, y) with a sloping top z_top_fn(x, y)."""
+    import bmesh
+    bm = bmesh.new()
+    low = [bm.verts.new((x, y, z_bottom)) for x, y in plan]
+    high = [bm.verts.new((x, y, z_top_fn(x, y))) for x, y in plan]
+    n = len(plan)
+    for i in range(n):
+        j = (i + 1) % n
+        bm.faces.new((low[i], low[j], high[j], high[i]))
+    bm.faces.new(list(reversed(low)))
+    bm.faces.new(high)
+    bmesh.ops.recalc_face_normals(bm, faces=list(bm.faces))
+    P.bevel_edges(bm, bevel, 1)
+    return P.finish(builder, name, bm, mat)
+
+
+def build_plows(builder):
+    """Truck cowcatcher plow (End B) and the speedster's pointed prow (End A)."""
+    out = []
+    x0, x1 = T.X(228), T.X(278)
+    z0, z1 = 0.12, 0.54
+    plan = [(x0, 0.0), (T.X(250), 0.60), (x1, 0.60), (x1 + 0.07, 0.42), (x1 + 0.07, -0.42),
+            (x1, -0.60), (T.X(250), -0.60)]
+    plan = [(x0, 0.0), (T.X(250), 0.60), (x1, 0.60), (x1 + 0.07, 0.42), (x1 + 0.07, -0.42),
+            (x1, -0.60), (T.X(250), -0.60)]
+
+    def top(x, y):
+        return z0 + (z1 - z0) * min(1.0, max(0.0, (x - x0) / (x1 - x0)))
+    out.append(wedge(builder, "Body_PlowTruck", plan, z0 - 0.025, top, "iron"))
+    # speedster prow: a long pointed wedge that falls to the ground line
+    stations = []
+    for px, w, zt in ((866, 0.18, 0.60), (874, 0.16, 0.52), (884, 0.14, 0.44), (896, 0.10, 0.30),
+                      (908, 0.06, 0.18), (918, 0.025, 0.13), (925, 0.004, 0.10)):
+        half, roles = F.section_half(w, 0.085, zt, 0.015, 0.03, 0.01, steps=2, crown_steps=2)
+        stations.append((T.X(px), F.full_ring(half, roles)[0]))
+    prow = F.loft(builder, "Body_ProwSpeedster", stations, ["iron"], row_mats=[0] * len(stations[0][1]))
+    out.append(prow)
+    for k, yy in enumerate((-0.07, 0.0, 0.07)):
+        pts = [(T.X(px), yy * (1 - (px - 866) / 70.0), zt + 0.006) for px, zt in
+               ((868, 0.595), (876, 0.52), (884, 0.438), (896, 0.30), (908, 0.185), (918, 0.14))]
+        out.append(P.sweep(builder, f"Trim_ProwRib_{k}", pts, "brass", radius=0.0075, sides=6))
+    return out
+
+
+def side_y(px):
+    """Hull half-width at an arbitrary px (linear between hull stations, as the loft is)."""
+    return T.lerp_table([(p, T.half_w(p)) for p in HULL_PX], px)
+
+
+def roof_z(px):
+    """Hull top height (flat part, before crown) at an arbitrary px."""
+    return T.lerp_table([(p, hull_top(p)) for p in HULL_PX], px)
+
+
+def top_surface_z(px, y):
+    """Exact hull top height at (px, |y|), interpolated on the lofted rings (flat or crowned)."""
+    i = max(1, min(len(HULL_PX) - 1, next((k for k, p in enumerate(HULL_PX) if p >= px), len(HULL_PX) - 1)))
+    p0, p1 = HULL_PX[i - 1], HULL_PX[i]
+    t = (px - p0) / (p1 - p0)
+    zs = []
+    for p in (p0, p1):
+        ring, _ = hull_ring(p)
+        half = [(yy, zz) for yy, zz in ring if yy >= -1e-9 and zz > ring[0][1] + 0.1]
+        half.sort()
+        a = abs(y)
+        z = half[-1][1]
+        for (ya, za), (yb, zb) in zip(half, half[1:]):
+            if ya <= a <= yb and yb > ya:
+                z = za + (zb - za) * (a - ya) / (yb - ya)
+                break
+        zs.append(z)
+    return zs[0] + (zs[1] - zs[0]) * t
diff --git a/tools/vehicle_pipeline/blender/boilerfang_cab.py b/tools/vehicle_pipeline/blender/boilerfang_cab.py
new file mode 100644
index 0000000..b90565a
--- /dev/null
+++ b/tools/vehicle_pipeline/blender/boilerfang_cab.py
@@ -0,0 +1,233 @@
+"""Cab and cockpit glazing, window frames, doors, stripes and roof skylights.
+
+Glass is a thin closed slab seated 2..5 mm off the flat hull side (or flat windshield slope);
+brass frame bars sit on top of it. All of it is mirrored by construction (left = right).
+"""
+import math
+
+import bmesh
+from mathutils import Vector
+
+import boilerfang_body as B
+import boilerfang_forms as F
+import boilerfang_prims as P
+import boilerfang_trace as T
+
+SIDES = (-1, 1)
+SEAT = 0.002  # glass inner face stand-off from the hull
+THICK = 0.003
+
+
+def tag(side):
+    return f"{side:+d}"
+
+
+def _cols(px0, px1):
+    cols = [px0] + [p for p in B.HULL_PX if px0 < p < px1] + [px1]
+    return cols
+
+
+def slab(builder, name, grid_in, grid_out, mat="glass"):
+    """Closed thin solid between two same-topology grids of points (rows x cols)."""
+    bm = bmesh.new()
+    rows, cols = len(grid_in), len(grid_in[0])
+    vi = [[bm.verts.new(p) for p in row] for row in grid_in]
+    vo = [[bm.verts.new(p) for p in row] for row in grid_out]
+    for r in range(rows - 1):
+        for c in range(cols - 1):
+            bm.faces.new((vo[r][c], vo[r][c + 1], vo[r + 1][c + 1], vo[r + 1][c]))
+            bm.faces.new((vi[r][c], vi[r + 1][c], vi[r + 1][c + 1], vi[r][c + 1]))
+    for c in range(cols - 1):
+        bm.faces.new((vi[0][c], vi[0][c + 1], vo[0][c + 1], vo[0][c]))
+        bm.faces.new((vi[-1][c + 1], vi[-1][c], vo[-1][c], vo[-1][c + 1]))
+    for r in range(rows - 1):
+        bm.faces.new((vi[r + 1][0], vi[r][0], vo[r][0], vo[r + 1][0]))
+        bm.faces.new((vi[r][-1], vi[r + 1][-1], vo[r + 1][-1], vo[r][-1]))
+    bmesh.ops.recalc_face_normals(bm, faces=list(bm.faces))
+    return P.finish(builder, name, bm, mat, smooth_angle=60)
+
+
+def side_window(builder, name, side, corners):
+    """corners = [(px_a, zb_a), (px_b, zb_b), (px_b, zt_b), (px_a, zt_a)]; seated on the flat side."""
+    (pa, zba), (pb, zbb), (_, ztb), (_, zta) = corners
+    cols = _cols(pa, pb)
+    grid_in, grid_out = [], []
+    for row in (0, 1):
+        gi, go = [], []
+        for p in cols:
+            t = (p - pa) / (pb - pa)
+            z = (zba + (zbb - zba) * t) if row == 0 else (zta + (ztb - zta) * t)
+            y = B.side_y(p)
+            gi.append((T.X(p), side * (y + SEAT), z))
+            go.append((T.X(p), side * (y + SEAT + THICK), z))
+        grid_in.append(gi)
+        grid_out.append(go)
+    obj = slab(builder, name, grid_in, grid_out)
+    return obj, cols, (grid_in, grid_out)
+
+
+def frame_bars(builder, name, side, corners, bar=0.016, depth=0.012):
+    """Brass frame around a side window: four sweeps hugging the hull side."""
+    (pa, zba), (pb, zbb), (_, ztb), (_, zta) = corners
+    cols = _cols(pa, pb)
+    out = []
+    off = SEAT + depth / 2 - 0.001
+
+    def edge(row):
+        pts = []
+        for p in cols:
+            t = (p - pa) / (pb - pa)
+            z = (zba + (zbb - zba) * t) if row == 0 else (zta + (ztb - zta) * t)
+            pts.append((T.X(p), side * (B.side_y(p) + off), z + (-bar / 2 if row == 0 else bar / 2)))
+        return pts
+    prof = [(-depth / 2, -bar / 2), (depth / 2, -bar / 2), (depth / 2, bar / 2), (-depth / 2, bar / 2)]
+    out.append(P.sweep(builder, name + "_Bot", edge(0), "brass", profile=prof, up=(0, 0, 1)))
+    out.append(P.sweep(builder, name + "_Top", edge(1), "brass", profile=prof, up=(0, 0, 1)))
+    for k, (p, zb, zt) in enumerate(((pa, zba, zta), (pb, zbb, ztb))):
+        xo = -bar / 2 if k == 0 else bar / 2
+        y = side * (B.side_y(p) + off)
+        out.append(P.sweep(builder, f"{name}_End{k}", [(T.X(p) + xo, y, zb - bar),
+                                                         (T.X(p) + xo, y, zt + bar)], "brass",
+                           profile=[(-depth / 2, -bar / 2), (depth / 2, -bar / 2), (depth / 2, bar / 2),
+                                    (-depth / 2, bar / 2)], up=(1, 0, 0)))
+    return out
+
+
+def sloped_window(builder, name, px0, px1, ymax, ymid=0.012):
+    """Windshield panes on the flat sloped top between px0 and px1 (two panes + centre mullion)."""
+    cols = _cols(px0, px1)
+    out = []
+    for side in SIDES:
+        y0, y1 = side * ymid, side * ymax
+        gi, go = [], []
+        for y in (y0, y1):
+            ri, ro = [], []
+            for p in cols:
+                z = B.roof_z(p)
+                ri.append((T.X(p), y, z + SEAT))
+                ro.append((T.X(p), y, z + SEAT + THICK))
+            gi.append(ri)
+            go.append(ro)
+        if side < 0:
+            gi, go = gi[::-1], go[::-1]
+        out.append(slab(builder, f"{name}_{tag(side)}", gi, go))
+    return out
+
+
+def sloped_frame(builder, name, px0, px1, ymax, bar=0.018, depth=0.012):
+    cols = _cols(px0, px1)
+    out = []
+    prof = [(-bar / 2, -depth / 2), (bar / 2, -depth / 2), (bar / 2, depth / 2), (-bar / 2, depth / 2)]
+    off = SEAT + depth / 2 - 0.001
+    for k, y in enumerate((-ymax, 0.0, ymax)):
+        pts = [(T.X(p), y, B.roof_z(p) + off) for p in cols]
+        out.append(P.sweep(builder, f"{name}_Rail{k}", pts, "brass", profile=prof, up=(0, 1, 0)))
+    for k, p in enumerate((px0, px1)):
+        pts = [(T.X(p), -ymax, B.roof_z(p) + off), (T.X(p), ymax, B.roof_z(p) + off)]
+        out.append(P.sweep(builder, f"{name}_Cross{k}", pts, "brass",
+                           profile=[(-depth / 2, -bar / 2), (depth / 2, -bar / 2), (depth / 2, bar / 2),
+                                    (-depth / 2, bar / 2)], up=(1, 0, 0)))
+    return out
+
+
+WINDOWS = {
+    # name: corners (px, z) bottom-left, bottom-right, top-right, top-left
+    "TruckDoor": [(468, 0.994), (510, 0.994), (510, 1.214), (468, 1.214)],
+    "TruckQuarter": [(525, 0.994), (560, 0.994), (560, 1.19), (525, 1.19)],
+    "SpeedsterSide": [(636, 0.655), (688, 0.655), (688, 0.775), (636, 0.80)],
+}
+
+
+def build_glazing(builder):
+    out = {"glass": [], "frames": []}
+    for name, corners in WINDOWS.items():
+        for side in SIDES:
+            g, cols, _ = side_window(builder, f"Glass_{name}_{tag(side)}", side, corners)
+            out["glass"].append(g)
+            out["frames"] += frame_bars(builder, f"Frame_{name}_{tag(side)}", side, corners)
+    out["glass"] += sloped_window(builder, "Glass_TruckWindshield", 436.5, 452.0, 0.36)
+    out["frames"] += sloped_frame(builder, "Frame_TruckWindshield", 436.5, 452.0, 0.36)
+    out["glass"] += sloped_window(builder, "Glass_SpeedsterWindshield", 703.0, 720.0, 0.27)
+    out["frames"] += sloped_frame(builder, "Frame_SpeedsterWindshield", 703.0, 720.0, 0.27)
+    return out
+
+
+SKYLIGHT_PX = (484, 516, 548)
+
+
+def build_skylights(builder):
+    """Raised brass hatches with glass panes seated below the rim (clerestory skylights)."""
+    out = {"glass": [], "frames": []}
+    for k, px in enumerate(SKYLIGHT_PX):
+        x = T.X(px)
+        zr = B.top_surface_z(px, 0.0)
+        crown = 0.0
+        lx, ly = 0.20, 0.42
+        wall, h = 0.022, 0.15
+        zc = zr + crown + 0.5 * h - 0.075
+        zt = zc + h / 2
+        out["frames"].append(P.rbox(builder, f"Frame_Skylight_{k}_L", (lx, wall, h), "brass", bevel=0.005,
+                                    location=(x, -ly / 2 + wall / 2, zc)))
+        out["frames"].append(P.rbox(builder, f"Frame_Skylight_{k}_R", (lx, wall, h), "brass", bevel=0.005,
+                                    location=(x, ly / 2 - wall / 2, zc)))
+        out["frames"].append(P.rbox(builder, f"Frame_Skylight_{k}_F", (wall, ly - 2 * wall + 0.002, h), "brass",
+                                    bevel=0.005, location=(x - lx / 2 + wall / 2, 0.0, zc)))
+        out["frames"].append(P.rbox(builder, f"Frame_Skylight_{k}_B", (wall, ly - 2 * wall + 0.002, h), "brass",
+                                    bevel=0.005, location=(x + lx / 2 - wall / 2, 0.0, zc)))
+        gx, gy = lx - 2 * wall + 0.012, ly - 2 * wall + 0.012
+        zg = zt - 0.020
+        gi = [[(x - gx / 2, -gy / 2, zg), (x + gx / 2, -gy / 2, zg)],
+              [(x - gx / 2, gy / 2, zg), (x + gx / 2, gy / 2, zg)]]
+        go = [[(a, b, c + THICK) for a, b, c in row] for row in gi]
+        out["glass"].append(slab(builder, f"Glass_Skylight_{k}", gi, go))
+    return out
+
+
+def side_strip(builder, name, side, px_list, z, height, thick, mat, lift=0.0):
+    """Thin band hugging the flat hull side (stripe, belt moulding, door outline)."""
+    prof = [(-thick / 2, -height / 2), (thick / 2, -height / 2), (thick / 2, height / 2), (-thick / 2, height / 2)]
+    pts = [(T.X(p), side * (B.side_y(p) + thick / 2 - 0.0005 + lift), z) for p in px_list]
+    return P.sweep(builder, name, pts, mat, profile=prof, up=(0, 0, 1))
+
+
+def vstrip(builder, name, side, px, z0, z1, width, thick, mat):
+    y = side * (B.side_y(px) + thick / 2 - 0.0005)
+    prof = [(-thick / 2, -width / 2), (thick / 2, -width / 2), (thick / 2, width / 2), (-thick / 2, width / 2)]
+    return P.sweep(builder, name, [(T.X(px), y, z0), (T.X(px), y, z1)], mat, profile=prof, up=(1, 0, 0))
+
+
+def build_doors_and_stripes(builder):
+    out = []
+    for side in SIDES:
+        s = tag(side)
+        # red body stripe and a brass belt moulding along the flat flank
+        px_list = [p for p in B.HULL_PX if 440 <= p <= 702]
+        out.append(side_strip(builder, f"Trim_Stripe_{s}", side, px_list, 0.545, 0.034, 0.004, "accent"))
+        out.append(side_strip(builder, f"Trim_Belt_{s}", side, px_list, 0.585, 0.012, 0.007, "brass"))
+        # truck door outline, hinges and handle
+        da, db, za, zb = 463, 516, 0.60, 1.25
+        cols = _cols(da, db)
+        out.append(side_strip(builder, f"Trim_DoorBottom_{s}", side, cols, za, 0.012, 0.006, "iron"))
+        out.append(side_strip(builder, f"Trim_DoorTop_{s}", side, cols, zb - 0.02, 0.012, 0.006, "iron"))
+        out.append(vstrip(builder, f"Trim_DoorFront_{s}", side, da, za, zb - 0.02, 0.012, 0.006, "iron"))
+        out.append(vstrip(builder, f"Trim_DoorRear_{s}", side, db, za, zb - 0.02, 0.012, 0.006, "iron"))
+        for k, z in enumerate((0.70, 0.95, 1.18)):
+            y = side * (B.side_y(da) + 0.012)
+            out.append(F.revolve(builder, f"Fine_DoorHinge_{s}_{k}", [
